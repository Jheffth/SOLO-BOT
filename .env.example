# ══════════════════════════════════════════════════════════════════
#  MOLDE DO .env DO SOLO BOT — copie para .env e preencha.
#  O .env real NUNCA vai ao git.
#  Gere segredos com:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# ══════════════════════════════════════════════════════════════════

AMBIENTE=production
URL_PUBLICA=https://solobot.duckdns.org
CORS_ORIGINS=https://solobot.duckdns.org

# Banco próprio no mesmo Postgres (criar uma vez: createdb -U admin solo_bot_db)
DATABASE_URL=postgresql://admin:SENHA@solo_db:5432/solo_bot_db

# Assina a sessão do painel. Quem tem esta chave entra em qualquer conta.
SECRET_KEY=

# Quem vira administrador ao se cadastrar (vírgula separa)
ADMIN_EMAILS=jcs.costa.santos@gmail.com

# Quem não tem Conta Solo não recebe resposta nenhuma (só quem manda código de vínculo).
# 1 = volta a mandar a mensagem de boas-vindas para estranhos.
RESPONDER_DESCONHECIDOS=0

# ── Telegram (o bot que era do Rotinas) ───────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Sem ele o webhook recusa tudo (503). Não reaproveite o do Rotinas.
TELEGRAM_SECRET=

# ── WhatsApp (a Evolution do Rotinas) ─────────────────────────────
EVOLUTION_API_URL=http://evolution_api:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=solo_rotinas
# Vai no caminho do webhook: /api/whatsapp/webhook/<segredo>
EVOLUTION_WEBHOOK_SECRET=
# Só dígitos, com DDI: monta o link wa.me do painel
WHATSAPP_NUMERO=

# ── Voz: transcrição de áudio para os sistemas que não entendem áudio ─
# A mesma chave do Finances serve. Vazio = o bot pede para mandar por escrito.
GEMINI_API_KEY=
GEMINI_API_KEY_RESERVA=
GEMINI_MODEL=gemini-3.5-flash-lite
# Transcrição: principal tenta novamente em falhas temporárias e usa o modelo
# alternativo com a mesma chave. A interpretação dos comandos usa GEMINI_MODEL.
GEMINI_AUDIO_MODEL=gemini-3.5-flash-lite
GEMINI_AUDIO_MODEL_RESERVA=gemini-3.1-flash-lite
# Para desativar a alternativa: GEMINI_AUDIO_MODEL_RESERVA=nenhum
GROK_API_KEY=
# Chave de testes do Grok: usada só quando a caixa "Usar API Grok de Testes" (Ferramentas da Bella) está marcada
GROK_API_KEY_TESTE=
GROK_VISION_MODEL=
# Mostrador de saldo do Grok na Administração (opcional). Chave de GERENCIAMENTO, diferente da chave acima:
# console.x.ai → Settings → Management Keys. O ID do time aparece no console.
XAI_MANAGEMENT_KEY=
XAI_TEAM_ID=
# 1 libera conversa sexual explícita entre adultos no Modo Safada da Bella (vazio = desligado)
BELLA_CONTEUDO_ADULTO=
# Conversa pessoal da Bella: tamanho máximo da resposta (padrão 900) e memória curta
# (últimas N trocas, por tantos minutos, só em RAM; 0 turnos desliga).
BELLA_CONVERSA_MAX_CHARS=
BELLA_MEMORIA_TURNOS=
BELLA_MEMORIA_MINUTOS=

# ── Voz: responder falando (todos os sistemas) ─
ELEVENLABS_API_KEY=
ELEVENLABS_API_KEY_SECONDARY=
# Voz e modelo se escolhem em Administração → Voz do bot.
# Preenchendo aqui, eles ficam FIXOS e a tela não troca.
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=

# De quantos em quantos minutos o Solo Bot pede o manifesto de cada sistema (0 = nunca)
MANIFESTO_MINUTOS=10

# ── Sistemas ──────────────────────────────────────────────────────
# Um bloco por sistema. O token é o mesmo BOT_SERVICE_TOKEN do .env do sistema.
SOLO_MODULOS=[{"chave":"fin","nome":"Solo Finances","emoji":"💰","cor":"#34d399","descricao":"Lançamentos, saldos e extratos pelo chat.","url":"http://solo_finances:8000","token":"","painel":"https://solofinances.duckdns.org"},{"chave":"rot","nome":"Solo Rotinas","emoji":"⚔️","cor":"#a78bfa","descricao":"Missões do dia, dungeons e avisos.","url":"http://solo_routines:8000","token":"","painel":"https://soloroutines.duckdns.org"}]

# VoiceStudio: reserva apos todas as tentativas ElevenLabs.
# Use um endereco privado acessivel pela VPS. URL vazia desativa.
VOICESTUDIO_URL=
VOICESTUDIO_API_KEY=
VOICESTUDIO_VOICE_ID=
VOICESTUDIO_MODEL=omnivoice
VOICESTUDIO_TIMEOUT=120
